@startuml
hide circle
hide methods
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam backgroundColor White

skinparam class {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  HeaderBackgroundColor #1565C0
  HeaderFontColor White
  FontColor #FFFFFFF
}


class Customer {
  name
  contactDetails
}

class Producer {
  name
  collectionAddress
  contactDetails
}

class DeliveryRequest {
  serviceDate
  destination
  goodsDescription
  quantity
  handlingRequirement
  timingRequirement
  status
}

class Consignment {
  description
  quantity
  size
  weight
  fragility
  temperatureNeed
  loadingPosition
  status
}

class Vehicle {
  capacity
  access
  temperatureCapability
}

class Driver {
  availability
  licence
  localAccessConstraint
}

class Route {
  routeDate
  readinessStatus
}

class RouteVersion {
  versionNumber
  publishedDateTime
}

class DepotCheck {
  checkedDateTime
  quantityConfirmed
  condition
  result
}

class DeliveryOutcome {
  outcomeType
  recordedDateTime
  notes
}

Customer " 1" -- "0..*	" DeliveryRequest : places
Producer "1   " -- "0..*" DeliveryRequest : is collection point for
DeliveryRequest "1..*	" -- "1..*	" Consignment : is fulfilled by
Consignment "0..*" -- "0..1" Route : is loaded on
Route "1  " -- "1..*  " RouteVersion : has

Vehicle "0..1  " -- "0..*	" Route : is used on
Driver "0..1   " -- "	0..*" Route : drives
Consignment "1" -- "0..*" DepotCheck : is checked by
Consignment "1" -- "		0..*" DeliveryOutcome : results in
Driver "1 " -- "0..*" DeliveryOutcome : records



@enduml